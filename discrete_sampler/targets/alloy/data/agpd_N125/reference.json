      "n_sites": 16,
      "n_configurations": 65536,
      "max_abs_ln_z_difference": 0.033515360693485374,
      "rms_ln_z_difference": 0.012829391551816218,
      "max_abs_f_mix_difference_eV_per_atom": 0.00018524565923080938,
      "closed_form_vs_enumeration": 4.973799150320701e-14,
      "n_samples": 4000
    },
    "replica_exchange": {
      "worst_rung_swap_acceptance": 0.9461895424835487,
      "min_round_trips_per_unit": 135433,
      "what": "a severed ladder shows a flat stretch in the fraction of up-movers and zero round trips, with nothing to compare against"
    },
    "independent_algorithm": {
      "n_points": 2349,
      "n_walkers_converged": 2344,
      "max_abs_dc_where_walkers_agree": 0.0036201200331954578,
      "median_abs_dc_where_walkers_agree": 5.551101769812883e-05,
      "max_abs_dc_overall": 0.3356366017870545,
      "fraction_walkers_trapped": 0.0021285653469561515,
      "fraction_saturated": 0.01319710515112814,
      "min_walker_c_variance_unsaturated": 0.0,
      "what": "<c>(dmu, T) from the two routes. They share only the Hamiltonian, so agreement is evidence rather than precision.",
      "caveat": "`max_abs_dc_where_walkers_agree` can be large even though the walkers agree with each other. The spread test detects walkers landing in DIFFERENT basins; it cannot detect all of them landing in the SAME wrong one, which is what happens when the barrier is crossed early and never again. At those conditions the disagreement between the two routes is itself the signal, and the multicanonical route is the one to trust: its bias removes the composition barrier by construction, and it is the route the closed-form anchors and the exhaustive enumeration bound."
    },
    "vs_published_metadynamics": {
      "status": "compared",
      "n_temperatures": 15,
      "max_abs_diff_eV_per_atom": 0.0005123030145364124,
      "median_max_abs_diff_eV_per_atom": 0.00036913712864422576,
      "max_relative_diff": 0.005644653447377148
    },
    "tie_line_thresholds": {
      "our_boundaries": "00_results/phase_diagram.json uses a depth threshold of 5 sigma of the MEASURED statistical error on f_mix, per temperature. A fixed threshold is not safe: 1e-5 eV/atom is only ~1.4x the error at the hot end, and the convex-hull depth is a maximum over hundreds of noisy points, so a fixed rule manufactured tie lines up to the top of the temperature range on the 512-site cells.",
      "vs_published": "the comparison in comparison_to_published.json instead uses the source notebooks' own rule -- a gap wider than 8 composition steps, ~0.064 of the axis -- applied identically to both arrays, which is what makes it like-for-like.",
      "notebook_rule_steps_for_this_cell": 8
    },
    "vs_published_boundaries": {
      "status": "compared",
      "gap_threshold_steps": 8,
      "max_boundary_composition_diff": 0.032
    },
