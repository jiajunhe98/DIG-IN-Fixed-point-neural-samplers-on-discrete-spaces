  "gates": {
    "closed_form_anchors": {
      "what": "ln Z_N at N = 0, 1, n_sites-1, n_sites is known exactly. N = 0 pins the additive constant; the other three are held out.",
      "worst_held_out_residual_lnZ": 0.15231987201721608
