{
  "system": "cuau",
  "N": 128,
  "kind": "discrete",
  "degrees_of_freedom": "one binary spin per lattice site; no positions, no volume.  The sibling cuni_N256 and cuag_N108 packages are hybrid, with continuous (u, w) channels this system does not have.",
  "conventions": {
    "s": "spin per site, +1 = Au, -1 = Cu",
    "c": "fraction of spin-up sites",
    "dmu": "mu_Au - mu_Cu [eV]",
    "H": "H(s) = E(s) - (dmu/2) sum_i s_i",
    "E": "mixing energy, pure limits subtracted",
    "lattice": "fcc, 8x4x4 primitive cells, a = 3.8 A",
    "kB": "8.617e-05 eV/K",
    "sweeps": "published grid: dmu in [-0.2, 0.15] eV step 0.01; T in [200.0, 1200.0] K step 25.0"
  },
  "schema": {
    "lnZ.npz": {
      "T": "(nT,) the published temperature sweep [K]",
      "n": "(N+1,) number of spin-up atoms",
      "composition": "(N+1,) c = n/N",
      "lnZ": "(nT, N+1) ln Z_n(T), fixed composition, ONE additive constant per isotherm, pinned by the closed form at n=0",
      "lnZ_err": "(nT, N+1) standard error from 8 independent repeats",
      "valid": "(nT, N+1) False where no repeat sampled that composition",
      "f_mix": "(nT, N+1) mixing free energy [eV/atom], relative to the pure-limit tie line -- directly comparable to the published metadynamics arrays in published/",
      "f_mix_err": "(nT, N+1) its standard error [eV/atom]",
      "e_mean, e2_mean": "(nT, N+1) <E>, <E^2> at fixed (T, n) [eV]",
      "warren_cowley": "(nT, N+1) first-shell short-range order",
      "eta_mean, eta2_mean": "(nT, N+1, 3) fcc X-point order parameters; absent for an odd cell",
      "ladder_*": "the same quantities on the full beta-uniform tempering ladder (up to 2400 K), which is what was simulated; the unprefixed arrays are its restriction to the published sweep",
      "anchor_n, anchor_lnZ": "the closed-form values, (4,) and (4, nT)"
    },
    "state_points.npz": {
      "dmu": "(nD,) [eV]",
      "T": "(nT,) [K]",
      "c": "(nD, nT, W) mean composition, PER WALKER",
      "c_var": "(nD, nT, W) its variance within each walker",
      "E, E_sq": "(nD, nT, W) mean energy and mean square [eV]",
      "eta": "(nD, nT, W, 3) X-point order parameters",
      "c_spread": "(nD, nT) range of the per-walker mean composition",
      "trapped": "(nD, nT) walkers that never agreed -- plain MC has not crossed the barrier there and its average is a composition no configuration visits",
      "saturated": "(nD, nT) every walker in the same pure state; the equilibrium really is one configuration, so zero variance is correct rather than stuck",
      "note": "plain Metropolis, no bias and no tempering. Sample averages only -- no estimator, no anchor."
    }
  },
  "routes": {
    "multicanonical": "Wang-Landau flattening of the composition histogram, then FROZEN bias with replica exchange over a beta-uniform ladder. Gives ln Z_n(T), hence the whole dmu axis analytically.",
    "direct_sgc": "plain semi-grand Metropolis at each published (dmu, T), many walkers. Independent of the above in algorithm and in run; where they disagree, `trapped` says why."
  },
